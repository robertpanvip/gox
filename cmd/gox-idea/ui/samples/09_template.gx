// 模板字符串（反引号内插值）+ 参数默认值（尾部缺失参数自动补全）
func greet(name string = "GX", mark string = "!") string {
    return `你好, ${name}${mark}`
}
sig who = "world"
func fullText() string { return greet(who) }
func defaultText() string { return greet() }
func change() { who = "GX" }
func view() *gxscene.Instance {
    return <div style={{ flexDirection: "column", gap: 8 }}>
        <button onClick={change} style={{ padding: 8 }}>换名字</button>
        <span style={{ color: "#c3e88d", fontSize: 16 }}>{fullText()}</span>
        <span style={{ color: "#858585" }}>{defaultText()}</span>
    </div>
}
