package main

import (
    "fmt"
    "strconv"
)

func double(x int) int { return x * 2 }
func even(x int) bool { return x % 2 == 0 }

pub func run() {
    nums := []int{1, 2, 3, 4, 5, 6}

    // 换型链式：int → string，再过滤
    labels := nums.map(strconv.itoa).filter(func(s string) bool { return len(s) == 1 })

    // 同型链式 + reduce（换累加器类型）
    total := nums.filter(even).map(double).reduce(0, func(acc int, x int) int { return acc + x })

    fmt.println(labels, total)
}

func main() { run() }
