package main

import "fmt"

pub enum color { red, green, blue }

// 显式赋值的枚举（私有 enum：类型/常量/Parse 全部私有，不泄漏公开符号）
enum status { pending = 1, active = 2, done = 3 }

// 字符串枚举
pub enum method string { get = "GET", post = "POST" }

// 位标志
pub enum perm { read = 1 << iota, write, exec }

pub func name(c color) string {
    if c == ColorRed { return "red" }
    if c == ColorGreen { return "green" }
    return "blue"
}

func main() {
    c := ColorRed
    m, _ := parseMethod("GET")
    fmt.println(name(c), statusPending, m, PermRead|PermWrite)
}
