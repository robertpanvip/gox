package main

import (
    "fmt"
    gxscene "github.com/robertpanvip/gox-sample/runtime/scene"
)

// card 把标题与列表渲染成常驻场景树；JSX 被编译成 gxscene opcode 模板 + getter。
pub func card(title string, items []string) any {
    return <div class="card">
        <h1>{title}</h1>
        <ul>
            {items}
        </ul>
        <img src="logo.png" alt />
    </div>
}

func main() {
    view := card("GX", []string{"a", "b"})
    fmt.println(view)
}
