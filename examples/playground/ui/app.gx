// app.gx —— 用 GX 语言编写的 playground 主界面。
//
// 与 editor.gx 一起构成"用 GX 写 GX playground"的自举案例：
// 所有 UI（工具栏 / 示例列表 / 编辑器 / 状态栏）都用 GX JSX 表达，
// 转译成标准 Go 场景树后，桌面（skia+GLFW）与网页（web+wasm）共用。
package ui

import (
    Signal "github.com/robertpanvip/gox/runtime/signal"
    gxscene "github.com/robertpanvip/gox/runtime/scene"
)

// ---- 示例库：每个示例就是一段 GX 源码文本 ----

pub type sample struct {
    pub name   string
    pub source string
}

pub sig sampleIndex = 0

// 示例源码是常量，缓存一份切片，避免每次切换/渲染列表都重新构造 5 个结构体。
// 下面的 sample 列表由 gen_samples.py 从 samples/*.gx 生成：
// 构建前必须先通过 gox fmt -check 与 gox check 门禁，全部通过才会写入。请勿手改。
func buildSamples() []sample {
    return []sample{
    // @@BEGIN-GENERATED-SAMPLES@@
        sample{name: "01 Hello GX", source: "// sig 声明 + 裸读（编译器自动补 ()）\nsig name = \"GX\"\nfunc view() *gxscene.Instance {\n    return <div>Hello, {name}!</div>\n}"},
        sample{name: "02 Counter", source: "// 事件传函数原值 + sig 读写 + 样式进 style struct\nsig count = 0\nfunc inc() {\n    count = count + 1\n}\nfunc view() *gxscene.Instance {\n    return <button onClick={inc} style={{ background: \"#3b82f6\", padding: 10 }}>Count: {count}</button>\n}"},
        sample{name: "03 For 列表", source: "// For + item getter（t() 读值）+ 样式进 style struct\nsig todos = []string{\"a\", \"b\", \"c\"}\nfunc view() *gxscene.Instance {\n    return <div style={{ flexDirection: \"column\", gap: 6 }}>\n        <For each={todos}>{(t string) => <span>{t()}</span>}</For>\n    </div>\n}"},
        sample{name: "04 样式卡片", source: "// style={{...}} 强类型 struct + 驼峰 key + 伪状态单词 key\nfunc view() *gxscene.Instance {\n    return <div\n        style={{\n            background: \"#0b1020\",\n            padding: 20,\n            borderRadius: 12,\n            flexDirection: \"column\",\n            gap: 8,\n            hover: { background: \"#1e293b\" },\n        }}\n    >\n        <b style={{ color: \"#7dd3fc\", fontSize: 24 }}>Card</b>\n        <span style={{ color: \"#94a3b8\" }}>用 GX style struct 写的样式</span>\n    </div>\n}"},
        sample{name: "05 响应式 computed", source: "// Signal.computed 派生 + Signal.batch 合并 + 事件传函数原值\nsig price = 10\nsig qty = 2\nvar total = Signal.computed(() => price * qty)\nfunc bump() {\n    Signal.batch(() => {\n        price = price + 1\n        qty = qty + 1\n    })\n}\nfunc view() *gxscene.Instance {\n    return <div style={{ flexDirection: \"column\", gap: 6 }}>\n        <span>Total: {total}</span>\n        <button onClick={bump}>加价加量</button>\n    </div>\n}"},
    // @@END-GENERATED-SAMPLES@@
    }
}

var sampleStore []sample = buildSamples()

pub func samples() []sample { return sampleStore }

// loadSample 切换示例：把示例源码灌进编辑器。
pub func loadSample(i int) {
    xs := samples()
    if i < 0 { i = 0 }
    if i >= len(xs) { i = len(xs) - 1 }
    // 一次批量提交：示例高亮、源码/行版本、光标、焦点合并为一帧 DOM 补丁。
    Signal.batch(func() {
        sampleIndex = i
        EditorSetText(xs[i].source)
        EditorHome()
        EditorFocus()
    })
}

pub func nextSample() { loadSample(sampleIndex + 1) }
pub func prevSample() { loadSample(sampleIndex - 1) }

// ---- 主界面 ----

// 选中态必须是读 sampleIndex 的 getter（不能是渲染时求值的局部变量快照），
// 否则切换示例后高亮不刷新——局部变量捕获的是渲染那一刻的 active 值。
func sampleRowBg(i int) string {
    if i == sampleIndex { return "#094771" }
    return "#252526"
}
func sampleRowFg(i int) string {
    if i == sampleIndex { return "#ffffff" }
    return "#cccccc"
}

func sampleRow(i int) *gxscene.Instance {
    xs := samples()
    if i >= len(xs) { return <div/> }
    name := xs[i].name
    return <div bg={sampleRowBg(i)} color={sampleRowFg(i)} padding="8" font-size="13" border-radius="4"
        onClick={() => loadSample(i)}>
        {name}
    </div>
}

// 工具栏按钮：Next / Prev。显式写 *gxscene.Instance 注解。
pub func nextButton() *gxscene.Instance {
    return <div bg="#0e639c" color="#ffffff" padding="8" font-size="13" border-radius="4"
        onClick={nextSample}>
        {"下一个 ▶"}
    </div>
}

pub func prevButton() *gxscene.Instance {
    return <div bg="#3a3d45" color="#ffffff" padding="8" font-size="13" border-radius="4"
        onClick={prevSample}>
        {"◀ 上一个"}
    </div>
}

pub func editorPanel() *gxscene.Instance {
    return Editor()
}

pub func sampleList() *gxscene.Instance {
    return <div flex-direction="column" gap="6">
        <For each={Indices(len(samples()))}>{(i int) => sampleRow(i())}</For>
    </div>
}

// Playground 返回完整界面场景树。两端装配层都调用这个函数。
pub func Playground() *gxscene.Instance {
    title := "GX Playground"
    sub := "用 GX 写 GX —— 桌面与网页同源"
    return <div bg="#1e1e1e" color="#d4d4d4" padding="20" flex-direction="column" gap="14" height="600" width="920">
        <div flex-direction="column" gap="4">
            <div color="#4ec9b0" font-size="24" weight="bold">{title}</div>
            <div color="#858585" font-size="13">{sub}</div>
        </div>
        <div flex-direction="row" gap="14" height="420">
            <div bg="#252526" padding="12" border-radius="8" width="200" flex-direction="column" gap="8">
                <div color="#9cdcfe" font-size="13" weight="bold">示例</div>
                {sampleList()}
            </div>
            <div flex-direction="column" gap="6" width="640">
                <div flex-direction="row" gap="8">
                    {prevButton()}
                    {nextButton()}
                    <div color="#858585" font-size="12" padding="8">{EditorStatus()}</div>
                </div>
                {editorPanel()}
            </div>
        </div>
        <div color="#6a9955" font-size="12">提示：点击「下一个」切换示例；键盘输入由装配层转发到编辑器命令。</div>
    </div>
}
