// editor.gx —— 用 GX 语言编写的 Ace 风格代码编辑器。
//
// 这是 playground 的核心组件，全部逻辑用 GX 表达（sig 源、pub 函数、
// 字符串处理、For 列表、动态属性），转译成标准 Go 后由任意 gxscene 后端渲染：
// 桌面（skia + GLFW）与网页（web + wasm）共用这一份源码，零条件编译。
//
// 编辑器数据模型：
//   - Source      sig string  当前代码文本
//   - CursorLine  sig int     光标所在行（0 基）
//   - CursorCol   sig int     光标所在列（rune 计，0 基）
//   - Focused     sig bool    是否有焦点（驱动光标行高亮）
//   - SelAnchor   sig int×2   选区锚点行列（与光标重合即无选区，纯点击天然折叠）
//
// 命令式编辑操作（insert/backspace/newline/move）都是 pub 函数，装配层在
// 收到平台键盘事件后直接调用——不暴露 NodeID，不区分桌面还是网页。
package ui

import (
    "strings"
    "strconv"
    Signal "github.com/robertpanvip/gox/runtime/signal"
    gxscene "github.com/robertpanvip/gox/runtime/scene"
)

// ---- 编辑器状态（包级 sig，单编辑器 playground 足够） ----

pub sig sourceCode = "// 用 GX 写的编辑器，试着输入 GX 代码\nsig count = 0\nfunc main() {\n    count = count + 1\n}"
pub sig cursorLine = 0
pub sig cursorCol = 0
// 选区锚点：与光标 (cursorLine, cursorCol) 重合即无选区。
pub sig selAnchorLine = 0
pub sig selAnchorCol = 0
pub sig editorFocused = false
// 行数单独成 sig：<For> 只在行数变化时重算；单字符编辑不再重建列表 diff。
pub sig lineCount = len(splitLines(sourceCode))

// ---- 字符度量（Ace 风格：点击换算与光标渲染共用同一套） ----
// 等宽字体下一个 ASCII/窄字符宽 1 格，CJK/全角宽 2 格。charWidth 是"一格"
// 的像素宽度，由装配层在启动时用 canvas.measureText("0") 实测后注入——
// 这样点击落点与 caret.left 用完全相同的 runeCells × charWidth，绝不会错位。
// 桌面 skia 后端没有 canvas，注入值由 GL 字体度量给出；未注入时的默认值
// 与 13px monospace 一致，保证首帧也基本对齐。
pub sig charWidth = 7.83
// 全角/CJK 字符宽度。注意很多 monospace 字体里 CJK 并非恰好 2×ASCII：
// 例如 ui-monospace 下 ASCII 7.83px、CJK 13.02px。两个值都由前端 canvas 实测注入，
// 点击换算与 caret 定位共用，中文行也能像素级精确（对齐 Ace 的 fontMetrics）。
pub sig wideWidth = 13.02
// caretSettled：刚点击/输入后为 true（光标常亮），静置后由装配层置 false 恢复闪烁。
pub sig caretSettled = true

func runeCells(r rune) int {
    if r >= 0x1100 && (r <= 0x115f || r == 0x2329 || r == 0x232a ||
        (r >= 0x2e80 && r <= 0xa4cf && r != 0x303f) ||
        (r >= 0xac00 && r <= 0xd7a3) ||
        (r >= 0xf900 && r <= 0xfaff) ||
        (r >= 0xfe10 && r <= 0xfe19) ||
        (r >= 0xfe30 && r <= 0xfe6f) ||
        (r >= 0xff00 && r <= 0xff60) ||
        (r >= 0xffe0 && r <= 0xffe6)) {
        return 2
    }
    return 1
}

func cellPx(r rune) float64 {
    if runeCells(r) == 2 { return wideWidth }
    return charWidth
}

// prefixWidth 返回一行前 col 个 rune 的像素宽度（caret 的水平偏移来源）。
pub func prefixWidth(s string, col int) float64 {
    rs := []rune(s)
    acc := 0.0
    if col > len(rs) { col = len(rs) }
    for i := 0; i < col; i = i + 1 {
        acc = acc + cellPx(rs[i])
    }
    return acc
}

// pickColumn 是 prefixWidth 的逆运算：给定行内 x 像素，返回最近 rune 边界的列。
// 点击换算与 caret 渲染共用 runeWidth，因此"点哪列就落哪列"，中文行同样精确。
pub func pickColumn(idx int, x float64) int {
    s := lineText(idx)
    rs := []rune(s)
    acc := 0.0
    for i := 0; i < len(rs); i = i + 1 {
        w := cellPx(rs[i])
        if x < acc + w / 2 { return i }
        acc = acc + w
    }
    return len(rs)
}

// 行版本集合：一等细粒度响应式切片。每个元素都是独立 sig——改第 i 行版本
// 只通知订阅该行的 getter，这正是此前手写 24 个 rowVerN 具名 sig 想模拟的能力。
// Signal.newVec(...) 是 GX 语法糖，降级为 Signal.NewVec(...)。
func zeroRowVers() []int {
    out := []int{}
    for i := 0; i < 24; i = i + 1 {
        out = append(out, 0)
    }
    return out
}
var rowVers = Signal.newVec(zeroRowVers())

// ---- 纯文本编辑逻辑（GX 编写，两端共用） ----

pub func splitLines(s string) []string {
    return strings.Split(s, "\n")
}

pub func joinLines(ls []string) string {
    return strings.Join(ls, "\n")
}

pub func runeLen(s string) int {
    return len([]rune(s))
}

// indices 生成 [0, n) 的索引切片，<For> 逐行渲染时用。
pub func indices(n int) []int {
    out := []int{}
    for i := 0; i < n; i = i + 1 {
        out = append(out, i)
    }
    return out
}

// insertText 在当前光标处插入一个字符串（可为多字符/中文），返回新光标列。
pub func insertText(s string, ln int, col int, ins string) (string, int) {
    lines := splitLines(s)
    if ln < 0 { ln = 0 }
    if ln >= len(lines) { return s, col }
    rs := []rune(lines[ln])
    if col < 0 { col = 0 }
    if col > len(rs) { col = len(rs) }
    next := string(rs[:col]) + ins + string(rs[col:])
    lines[ln] = next
    return joinLines(lines), col + runeLen(ins)
}

// backspaceAt 删除光标前一个字符；行首退格则与上一行合并。返回新文本与新行列。
pub func backspaceAt(s string, ln int, col int) (string, int, int) {
    lines := splitLines(s)
    if ln < 0 || ln >= len(lines) { return s, ln, col }
    rs := []rune(lines[ln])
    if col > len(rs) { col = len(rs) }
    if col > 0 {
        next := string(rs[:col-1]) + string(rs[col:])
        lines[ln] = next
        return joinLines(lines), ln, col - 1
    }
    if ln > 0 {
        prev := []rune(lines[ln-1])
        merged := string(prev) + lines[ln]
        newLines := []string{}
        for i, l := range lines {
            if i == ln-1 {
                newLines = append(newLines, merged)
            } else if i != ln {
                newLines = append(newLines, l)
            }
        }
        return joinLines(newLines), ln - 1, len(prev)
    }
    return s, ln, col
}

// newlineAt 在当前光标处断行，返回新文本与新行列。
pub func newlineAt(s string, ln int, col int) (string, int, int) {
    lines := splitLines(s)
    if ln < 0 || ln >= len(lines) { return s, ln, col }
    rs := []rune(lines[ln])
    if col > len(rs) { col = len(rs) }
    left := string(rs[:col])
    right := string(rs[col:])
    newLines := []string{}
    for i, l := range lines {
        if i == ln {
            newLines = append(newLines, left, right)
        } else {
            newLines = append(newLines, l)
        }
    }
    return joinLines(newLines), ln + 1, 0
}

// ---- 选区引擎（Selection engine）----
// 选区 = anchor（锚点：拖拽起点 / 双击词首 / Shift 扩展时的原位）到 head（即光标）
// 的闭左开右区间。不设独立"有无选区"标志：锚点与光标重合即无选区，普通点击/
// 程序定位天然折叠选区。渲染见 selectionView：与固定 24 行同构的绝对定位色块。

pub func hasSelection() bool {
    return selAnchorLine != cursorLine || selAnchorCol != cursorCol
}

// selFrom/selTo 返回归一化后的选区两端（from ≤ to，行列均 0 基 rune 列）。
func selFrom() (int, int) {
    if selAnchorLine < cursorLine || (selAnchorLine == cursorLine && selAnchorCol <= cursorCol) {
        return selAnchorLine, selAnchorCol
    }
    return cursorLine, cursorCol
}

func selTo() (int, int) {
    if selAnchorLine < cursorLine || (selAnchorLine == cursorLine && selAnchorCol <= cursorCol) {
        return cursorLine, cursorCol
    }
    return selAnchorLine, selAnchorCol
}

// removeRange 删除 [from, to) 文本区间，返回新文本（纯函数，不碰信号）。
func removeRange(s string, fl int, fc int, tl int, tc int) string {
    lines := splitLines(s)
    if fl < 0 || fl >= len(lines) || tl >= len(lines) || fl > tl { return s }
    fr := []rune(lines[fl])
    tr := []rune(lines[tl])
    if fc > len(fr) { fc = len(fr) }
    if tc > len(tr) { tc = len(tr) }
    if fl == tl {
        lines[fl] = string(fr[:fc]) + string(fr[tc:])
        return joinLines(lines)
    }
    merged := string(fr[:fc]) + string(tr[tc:])
    out := []string{}
    for i, l := range lines {
        if i < fl {
            out = append(out, l)
        } else if i == fl {
            out = append(out, merged)
        } else if i > tl {
            out = append(out, l)
        }
    }
    return joinLines(out)
}

// deleteSelectionInner 删除选区并把光标落到选区起点（插入/退格/换行/Delete 共用）。
func deleteSelectionInner() {
    fl, fc := selFrom()
    tl, tc := selTo()
    text := removeRange(sourceCode, fl, fc, tl, tc)
    Signal.batch(func() {
        setSource(text)
        cursorLine = fl
        cursorCol = fc
        selAnchorLine = fl
        selAnchorCol = fc
    })
}

// ---- 撤销 / 重做（Ctrl+Z / Ctrl+Shift+Z） ----
// 每个编辑步骤压入"编辑前"的完整状态（源码 + 光标行列）；撤销恢复上一步，
// 重做把当前状态压回撤销栈。栈是普通 Go 状态，不参与响应式。恢复统一走
// setSource，因此 token 缓存、行版本与 LSP 会话都随源码一起同步。
// 连续插入单个字符各自成一步：Ace 也保留每一次击键的撤销粒度，playground
// 里连按 Ctrl+Z 即可逐字回退，语义简单可预期。
pub type editSnapshot struct {
    pub text string
    pub ln   int
    pub col  int
}
var undoStack []editSnapshot
var redoStack []editSnapshot

// pushUndo 在任何改变源码的命令之前调用，记录编辑前状态并清空重做分支。
func pushUndo() {
    undoStack = append(undoStack, editSnapshot{text: sourceCode, ln: cursorLine, col: cursorCol})
    redoStack = []editSnapshot{}
}

// EditorUndo 撤销上一步编辑；无历史时什么也不做。
pub func EditorUndo() {
    if len(undoStack) == 0 { return }
    n := len(undoStack)
    st := undoStack[n-1]
    undoStack = undoStack[:n-1]
    redoStack = append(redoStack, editSnapshot{text: sourceCode, ln: cursorLine, col: cursorCol})
    Signal.batch(func() {
        setSource(st.text)
        cursorLine = st.ln
        cursorCol = st.col
        selAnchorLine = st.ln
        selAnchorCol = st.col
        editorFocused = true
    })
}

// EditorRedo 重做一步；无重做历史时什么也不做。
pub func EditorRedo() {
    if len(redoStack) == 0 { return }
    n := len(redoStack)
    st := redoStack[n-1]
    redoStack = redoStack[:n-1]
    undoStack = append(undoStack, editSnapshot{text: sourceCode, ln: cursorLine, col: cursorCol})
    Signal.batch(func() {
        setSource(st.text)
        cursorLine = st.ln
        cursorCol = st.col
        selAnchorLine = st.ln
        selAnchorCol = st.col
        editorFocused = true
    })
}

// ---- 包级编辑命令：装配层收到键盘事件后调用 ----

// 所有编辑命令都在一个 Batch 内写信号：否则源码、行版本、光标、焦点各自独立
// 触发帧边界，一次点击/按键会提交多帧 DOM 补丁（点击示例曾观察到 4~5 次 Present）。
// Batch 只合并更新，不改变任何编辑语义；嵌套在 setSource 内部的 Batch 由最外层统一冲刷。
pub func editorInsert(s string) {
    pushUndo()
    text := sourceCode
    ln := cursorLine
    col := cursorCol
    if hasSelection() {
        fl, fc := selFrom()
        tl, tc := selTo()
        text = removeRange(text, fl, fc, tl, tc)
        ln = fl
        col = fc
    }
    next, c := insertText(text, ln, col, s)
    Signal.batch(func() {
        setSource(next)
        cursorLine = ln
        cursorCol = c
        selAnchorLine = ln
        selAnchorCol = c
        editorFocused = true
    })
}

pub func editorBackspace() {
    pushUndo()
    if hasSelection() {
        deleteSelectionInner()
        return
    }
    text, ln, c := backspaceAt(sourceCode, cursorLine, cursorCol)
    Signal.batch(func() {
        setSource(text)
        cursorLine = ln
        cursorCol = c
        selAnchorLine = ln
        selAnchorCol = c
    })
}

pub func editorNewline() {
    pushUndo()
    text := sourceCode
    ln := cursorLine
    col := cursorCol
    if hasSelection() {
        fl, fc := selFrom()
        tl, tc := selTo()
        text = removeRange(text, fl, fc, tl, tc)
        ln = fl
        col = fc
    }
    next, nl, c := newlineAt(text, ln, col)
    Signal.batch(func() {
        setSource(next)
        cursorLine = nl
        cursorCol = c
        selAnchorLine = nl
        selAnchorCol = c
    })
}

// moveCursorRel 相对移动光标并夹到合法范围（不含选区逻辑，供复用）。
func moveCursorRel(dln int, dcol int) {
    lines := splitLines(sourceCode)
    ln := cursorLine + dln
    if ln < 0 { ln = 0 }
    if ln >= len(lines) { ln = len(lines) - 1 }
    rs := []rune(lines[ln])
    c := cursorCol + dcol
    if c < 0 { c = 0 }
    if c > len(rs) { c = len(rs) }
    cursorLine = ln
    cursorCol = c
}

// editorMove 方向移动：有选区时先折叠再移动（左/上收到选区起点，右/下放到终点，
// Ace 语义），锚点跟随。
pub func editorMove(dln int, dcol int) {
    Signal.batch(func() {
        if hasSelection() {
            fl, fc := selFrom()
            tl, tc := selTo()
            if dln < 0 || (dln == 0 && dcol < 0) {
                cursorLine = fl
                cursorCol = fc
            } else {
                cursorLine = tl
                cursorCol = tc
            }
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
        moveCursorRel(dln, dcol)
        // 非 Shift 移动以"无选区的光标"收尾：锚点跟随到最终位置。
        selAnchorLine = cursorLine
        selAnchorCol = cursorCol
    })
}

// editorMoveEx 带 Shift 的方向移动：锚点不动扩展选区；首次移动先立锚点。
pub func editorMoveEx(dln int, dcol int, shift bool) {
    if !shift {
        editorMove(dln, dcol)
        return
    }
    Signal.batch(func() {
        if !hasSelection() {
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
        moveCursorRel(dln, dcol)
    })
}

pub func editorSetText(s string) {
    pushUndo()
    Signal.batch(func() {
        setSource(s)
        l, c := clampLineCol(cursorLine, cursorCol)
        cursorLine = l
        cursorCol = c
        selAnchorLine = l
        selAnchorCol = c
    })
}

// editorHome 一次性把光标归位。切换示例时旧实现调用两次 editorMove，
// 每次都 SplitLines + []rune 转换且各提交一帧；这里直接写两个标量 sig。
pub func editorHome() {
    Signal.batch(func() {
        cursorLine = 0
        cursorCol = 0
        selAnchorLine = 0
        selAnchorCol = 0
    })
}

// clampLineCol 把任意行列夹到合法范围（实际行数、行长），所有定位命令共用。
func clampLineCol(ln int, col int) (int, int) {
    lines := splitLines(sourceCode)
    if ln < 0 { ln = 0 }
    if ln >= len(lines) { ln = len(lines) - 1 }
    rs := []rune(lines[ln])
    if col < 0 { col = 0 }
    if col > len(rs) { col = len(rs) }
    return ln, col
}

// EditorSetCursor 把光标定位到指定行/列（点击代码行时由装配层调用），并折叠选区。
pub func EditorSetCursor(ln int, col int) {
    Signal.batch(func() {
        l, c := clampLineCol(ln, col)
        cursorLine = l
        cursorCol = c
        selAnchorLine = l
        selAnchorCol = c
        editorFocused = true
    })
}

// isWordRune 词字符：字母数字下划线 + CJK/全角（双击选中文段与 Ace 行为一致）。
func isWordRune(r rune) bool {
    if r == '_' || (r >= '0' && r <= '9') || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') {
        return true
    }
    return runeCells(r) == 2
}

// wordRunAt 返回 col（光标位）所在词的 [start, end)。col 落在词边界时优先取左侧词。
func wordRunAt(line string, col int) (int, int) {
    rs := []rune(line)
    if len(rs) == 0 { return 0, 0 }
    at := col
    if at > len(rs) { at = len(rs) }
    pick := at
    if at > 0 && (at == len(rs) || !isWordRune(rs[at])) { pick = at - 1 }
    if at < len(rs) && isWordRune(rs[at]) { pick = at }
    word := isWordRune(rs[pick])
    s := pick
    for s > 0 && isWordRune(rs[s-1]) == word { s = s - 1 }
    e := pick + 1
    for e < len(rs) && isWordRune(rs[e]) == word { e = e + 1 }
    return s, e
}

func firstNonSpace(rs []rune) int {
    for i, r := range rs {
        if r != ' ' && r != '\t' { return i }
    }
    return len(rs)
}

// ---- 选区命令（装配层按平台事件调用，桌面/网页共用同一语义）----

// editorClearSelection 折叠选区到光标处。
pub func editorClearSelection() {
    Signal.batch(func() {
        selAnchorLine = cursorLine
        selAnchorCol = cursorCol
    })
}

// editorSetSelect 拖拽/程序式定位：锚点与光标同时落到 (ln, col)（即无选区的定点）。
pub func editorSetSelect(ln int, col int) {
    Signal.batch(func() {
        l, c := clampLineCol(ln, col)
        cursorLine = l
        cursorCol = c
        selAnchorLine = l
        selAnchorCol = c
        editorFocused = true
    })
}

// editorExtendTo 拖拽移动 / Shift+点击：只移动光标，锚点保持原位。
pub func editorExtendTo(ln int, col int) {
    Signal.batch(func() {
        l, c := clampLineCol(ln, col)
        cursorLine = l
        cursorCol = c
        editorFocused = true
    })
}

// editorMoveWord Ctrl/Alt+方向：按词移动光标；shift 时保留锚点扩展选区。
pub func editorMoveWord(dir int, shift bool) {
    Signal.batch(func() {
        if !shift {
            if hasSelection() {
                fl, fc := selFrom()
                tl, tc := selTo()
                if dir < 0 {
                    cursorLine = fl
                    cursorCol = fc
                } else {
                    cursorLine = tl
                    cursorCol = tc
                }
                selAnchorLine = cursorLine
                selAnchorCol = cursorCol
            }
        } else if !hasSelection() {
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
        lines := splitLines(sourceCode)
        ln := cursorLine
        if ln >= len(lines) { ln = len(lines) - 1 }
        rs := []rune(lines[ln])
        c := cursorCol
        if c > len(rs) { c = len(rs) }
        if dir > 0 {
            for c < len(rs) && !isWordRune(rs[c]) { c = c + 1 }
            for c < len(rs) && isWordRune(rs[c]) { c = c + 1 }
        } else {
            for c > 0 && !isWordRune(rs[c-1]) { c = c - 1 }
            for c > 0 && isWordRune(rs[c-1]) { c = c - 1 }
        }
        cursorCol = c
        if !shift {
            // 非 Shift 的词移动同样要折叠锚点，否则锚点停在原地产生"幽灵选区"。
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
    })
}

// editorKeyHome Home 键：光标到首非空白、再到纯行首（Ace 两段式）；shift 扩展选区。
pub func editorKeyHome(shift bool) {
    Signal.batch(func() {
        if shift && !hasSelection() {
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
        rs := []rune(lineText(cursorLine))
        target := 0
        fns := firstNonSpace(rs)
        if cursorCol > fns {
            target = fns
        }
        cursorCol = target
        if !shift {
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
    })
}

// editorKeyEnd End 键：光标到行尾；shift 扩展选区。
pub func editorKeyEnd(shift bool) {
    Signal.batch(func() {
        if shift && !hasSelection() {
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
        rs := []rune(lineText(cursorLine))
        cursorCol = len(rs)
        if !shift {
            selAnchorLine = cursorLine
            selAnchorCol = cursorCol
        }
    })
}

// editorDeleteForward Delete 键：有选区删选区，否则删光标后字符（行尾则并入下行）。
pub func editorDeleteForward() {
    pushUndo()
    if hasSelection() {
        deleteSelectionInner()
        return
    }
    lines := splitLines(sourceCode)
    ln := cursorLine
    col := cursorCol
    if ln < 0 || ln >= len(lines) { return }
    rs := []rune(lines[ln])
    if col >= len(rs) {
        // 行尾：并入下一行（光标不动）。
        if ln >= len(lines)-1 { return }
        nxt := []rune(lines[ln+1])
        merged := lines[ln] + string(nxt)
        outLines := []string{}
        for i, l := range lines {
            if i == ln {
                outLines = append(outLines, merged)
            } else if i != ln+1 {
                outLines = append(outLines, l)
            }
        }
        joinText := joinLines(outLines)
        Signal.batch(func() {
            setSource(joinText)
            cursorLine = ln
            cursorCol = len(rs)
            selAnchorLine = ln
            selAnchorCol = len(rs)
        })
        return
    }
    next := string(rs[:col]) + string(rs[col+1:])
    lines[ln] = next
    text := joinLines(lines)
    Signal.batch(func() {
        setSource(text)
        selAnchorLine = ln
        selAnchorCol = col
    })
}

// editorSelectAll 全选。
pub func editorSelectAll() {
    Signal.batch(func() {
        lines := splitLines(sourceCode)
        selAnchorLine = 0
        selAnchorCol = 0
        cursorLine = len(lines) - 1
        cursorCol = runeLen(lines[len(lines)-1])
        editorFocused = true
    })
}

// editorSelectWord 双击选词：锚点落词首、光标落词尾。
pub func editorSelectWord(ln int, col int) {
    Signal.batch(func() {
        l, c := clampLineCol(ln, col)
        cursorLine = l
        s, e := wordRunAt(lineText(l), c)
        if s == e {
            selAnchorLine = l
            selAnchorCol = c
            cursorCol = c
        } else {
            selAnchorLine = l
            selAnchorCol = s
            cursorCol = e
        }
        editorFocused = true
    })
}

// editorSelectLine 三击选行：选中本行含行尾换行符（末行只选行内容）。
pub func editorSelectLine(ln int) {
    Signal.batch(func() {
        lines := splitLines(sourceCode)
        l := ln
        if l < 0 { l = 0 }
        if l >= len(lines) { l = len(lines) - 1 }
        selAnchorLine = l
        selAnchorCol = 0
        if l < len(lines)-1 {
            cursorLine = l + 1
            cursorCol = 0
        } else {
            cursorLine = l
            cursorCol = runeLen(lines[l])
        }
        editorFocused = true
    })
}

// editorSelectedText 返回选中文本（Ctrl+C / Ctrl+X 用）；无选区返回空串。
pub func editorSelectedText() string {
    if !hasSelection() { return "" }
    fl, fc := selFrom()
    tl, tc := selTo()
    lines := splitLines(sourceCode)
    if fl >= len(lines) || tl >= len(lines) { return "" }
    if fl == tl {
        fr := []rune(lines[fl])
        if fc > len(fr) || tc > len(fr) { return "" }
        return string(fr[fc:tc])
    }
    fr := []rune(lines[fl])
    tr := []rune(lines[tl])
    if fc > len(fr) { fc = len(fr) }
    if tc > len(tr) { tc = len(tr) }
    out := string(fr[fc:])
    for i := fl + 1; i < tl; i = i + 1 {
        out = out + "\n" + lines[i]
    }
    out = out + "\n" + string(tr[:tc])
    return out
}

// editorDeleteSelection 删除当前选区（Ctrl+X 的"剪"半边，复制由装配层负责）。
pub func editorDeleteSelection() {
    if !hasSelection() { return }
    pushUndo()
    deleteSelectionInner()
}

// editorPaste 粘贴（可含 \n 的多行文本）：有选区先删，再整体插入，光标落插入末尾。
pub func editorPaste(s string) {
    if s == "" { return }
    pushUndo()
    text := sourceCode
    ln := cursorLine
    col := cursorCol
    if hasSelection() {
        fl, fc := selFrom()
        tl, tc := selTo()
        text = removeRange(text, fl, fc, tl, tc)
        ln = fl
        col = fc
    }
    out := ""
    nl := ln
    nc := col
    if !strings.Contains(s, "\n") {
        next, c2 := insertText(text, ln, col, s)
        out = next
        nc = c2
    } else {
        lines := splitLines(text)
        if ln >= len(lines) { ln = len(lines) - 1 }
        rs := []rune(lines[ln])
        if col > len(rs) { col = len(rs) }
        left := string(rs[:col])
        right := string(rs[col:])
        parts := splitLines(s)
        newLines := []string{}
        for i, l := range lines {
            if i < ln {
                newLines = append(newLines, l)
            } else if i == ln {
                newLines = append(newLines, left+parts[0])
                for j := 1; j < len(parts)-1; j = j + 1 {
                    newLines = append(newLines, parts[j])
                }
                newLines = append(newLines, parts[len(parts)-1]+right)
                nl = ln + len(parts) - 1
                nc = runeLen(parts[len(parts)-1])
            } else {
                newLines = append(newLines, l)
            }
        }
        out = joinLines(newLines)
    }
    Signal.batch(func() {
        setSource(out)
        cursorLine = nl
        cursorCol = nc
        selAnchorLine = nl
        selAnchorCol = nc
        editorFocused = true
    })
}

pub func editorFocus() {
    Signal.batch(func() { editorFocused = true })
}
pub func editorBlur()  {
    Signal.batch(func() { editorFocused = false })
}
// editorSettle 标记"刚刚交互过"，caret 停止闪烁；静置由装配层定时调用 editorIdle 恢复闪烁。
pub func editorSettle() { Signal.batch(func() { caretSettled = true }) }
pub func editorIdle()   { Signal.batch(func() { caretSettled = false }) }
pub func setCharWidth(w float64)  { Signal.batch(func() { charWidth = w }) }
pub func setWideWidth(w float64) { Signal.batch(func() { wideWidth = w }) }
pub func editorLine() int { return cursorLine }
pub func editorCol() int { return cursorCol }
pub func editorText() string { return sourceCode }

// ---- caret 图层（Ace 的 cursor layer：场景节点，两端共用） ----
// caretLeft/caretTop 只依赖光标行列、当前行文本与 charWidth——都是精确叶子
// getter，光标移动只写这一个节点的两个属性，不触碰任何代码行、不重建子树。
// 容器 padding=6，行内 gutter(42)+marginRight(8)=50，故代码列左边界=56。
func caretLeft() float64 {
    return 56 + prefixWidth(lineText(cursorLine), cursorCol)
}
func caretTop() float64 {
    return 6 + float64(cursorLine * 22)
}

// ---- 选区色块度量（与 caretTop/prefixWidth 同一套坐标公式）----
// 每个色块读光标/锚点与该行文本（行版本隔离），无选区/行外时宽度 0 即隐形。
func selRectStartCol(idx int) int {
    fl, fc := selFrom()
    tl, tc := selTo()
    _ = tc
    if !hasSelection() || idx < fl || idx > tl { return 0 }
    if idx == fl { return fc }
    return 0
}

func selRectEndCol(idx int) int {
    fl, fc := selFrom()
    tl, tc := selTo()
    _ = fc
    if !hasSelection() || idx < fl || idx > tl { return 0 }
    if idx == tl { return tc }
    return runeLen(lineText(idx))
}

func selRectLeft(idx int) float64 {
    return 56 + prefixWidth(lineText(idx), selRectStartCol(idx))
}

func selRectWidth(idx int) float64 {
    t := lineText(idx)
    w := prefixWidth(t, selRectEndCol(idx)) - prefixWidth(t, selRectStartCol(idx))
    if w < 0 { w = 0 }
    return w
}

// selRectBg 无选区时返回空背景：Skia 布局对 width=0 的绝对定位节点会按内容量出
// 一个默认宽度（约 8px），若仍带 bg 就会在行号后画出一条竖带。bg 为空时 parseStyle
// 的 hasBg=false，Skia 不绘制；Web 端该色块本就 0 宽不可见，不受影响。
func selRectBg(idx int) string {
    if !hasSelection() || idx < selFromLine() || idx > selToLine() { return "" }
    if selRectWidth(idx) <= 0 { return "" }
    return "#264f7899"
}

func selFromLine() int {
    fl, _ := selFrom()
    return fl
}

func selToLine() int {
    tl, _ := selTo()
    return tl
}

func selRectTop(idx int) float64 {
    return 6 + float64(idx * 22)
}

// caretClass 用 class 表达光标三态，CSS 统一控制显示/闪烁：
//   失焦   → gx-caret-off（隐藏）
//   常亮   → gx-caret-steady（交互后 1s 内不闪，Ace 的 restartTimer）
//   闪烁   → 仅 gx-caret（静置后播放 blink 动画）
// 不用 inline opacity：CSS 动画优先级高于普通 inline style 会覆盖它。
func caretClass() string {
    if !editorFocused { return "gx-caret gx-caret-off" }
    if caretSettled { return "gx-caret gx-caret-steady" }
    return "gx-caret"
}

// ---- 语法高亮（GX 编写的类 Ace 分词器） ----

pub type token struct {
    pub text  string
    pub color string
}

func isAlpha(b byte) bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_' || b >= 0x80
}

func isAlnum(b byte) bool {
    return isAlpha(b) || (b >= '0' && b <= '9')
}

func isKeyword(w string) bool {
    switch w {
    case "func", "return", "if", "else", "for", "range", "var", "sig", "let",
         "pub", "type", "struct", "enum", "import", "package", "go", "defer",
         "nil", "true", "false", "any", "string", "int", "bool", "interface":
        return true
    }
    return false
}

// matchBrace 返回从 start 处的 '{' 开始、与之匹配的 '}' 下标；未找到返回 len。
// 跳过字符串字面量，支持嵌套 {}（JSX 插值里常见 {(t) => <span>{t()}</span>}）。
func matchBrace(line string, start int) int {
    depth := 0
    i := start
    for i < len(line) {
        if line[i] == '"' {
            i = i + 1
            for i < len(line) && line[i] != '"' {
                if line[i] == '\\' && i+1 < len(line) { i = i + 1 }
                i = i + 1
            }
        } else if line[i] == '{' {
            depth = depth + 1
        } else if line[i] == '}' {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i + 1
    }
    return len(line)
}

// highlight 把一行 GX 源码切成带颜色的 token，拼回去严格等于原文。
// 支持 Go 代码与 JSX：标签名、属性名、{插值} 分别着色，插值内部再按 Go 规则着色。
pub func highlight(line string) []token {
    // 预分配容量：一行通常每 2 个字符一个 token，避免 append 反复扩容。
    out := make([]token, 0, len(line)/2 + 1)
    i := 0
    inTag := false        // 是否处于 <...> 标签内部
    tagNamePending := false // 标签内尚未读到标签名
    for i < len(line) {
        // ---- JSX 标签内部 ----
        if inTag {
            if line[i] == '>' {
                out = append(out, token{text: ">", color: "#808080"})
                i = i + 1
                inTag = false
                continue
            }
            if line[i] == '/' && i+1 < len(line) && line[i+1] == '>' {
                out = append(out, token{text: "/>", color: "#808080"})
                i = i + 2
                inTag = false
                continue
            }
            // 属性值字符串（含转义）
            if line[i] == '"' {
                j := i + 1
                for j < len(line) && line[j] != '"' {
                    if line[j] == '\\' && j+1 < len(line) { j = j + 1 }
                    j = j + 1
                }
                if j < len(line) { j = j + 1 }
                out = append(out, token{text: line[i:j], color: "#ce9178"})
                i = j
                continue
            }
            // {插值}：递归按 Go 规则着色内部，含嵌套标签
            if line[i] == '{' {
                close := matchBrace(line, i)
                out = append(out, token{text: "{", color: "#808080"})
                if close < len(line) {
                    for _, t := range highlight(line[i+1 : close]) { out = append(out, t) }
                    out = append(out, token{text: "}", color: "#808080"})
                    i = close + 1
                } else {
                    i = i + 1
                }
                continue
            }
            // 标签名（第一个词）或属性名（允许 kebab-case）
            if isAlpha(line[i]) {
                j := i + 1
                for j < len(line) && isAlnum(line[j]) { j = j + 1 }
                for j+1 < len(line) && line[j] == '-' && isAlnum(line[j+1]) {
                    j = j + 1
                    for j < len(line) && isAlnum(line[j]) { j = j + 1 }
                }
                c := "#9cdcfe" // 属性名
                if tagNamePending { c = "#569cd6"; tagNamePending = false }
                out = append(out, token{text: line[i:j], color: c})
                i = j
                continue
            }
            c := "#808080"
            if line[i] == ' ' || line[i] == '\t' { c = "#d4d4d4" }
            out = append(out, token{text: line[i : i+1], color: c})
            i = i + 1
            continue
        }

        // ---- Go 代码 ----
        // JSX 开始标签：< 后跟字母（<div）；或闭合标签 </div>。
        if line[i] == '<' && i+1 < len(line) && (isAlpha(line[i+1]) || line[i+1] == '/') {
            out = append(out, token{text: "<", color: "#808080"})
            i = i + 1
            inTag = true
            tagNamePending = true
            if line[i] == '/' {
                out = append(out, token{text: "/", color: "#808080"})
                i = i + 1
            }
            continue
        }
        // 注释：行尾全绿
        if i+1 < len(line) && line[i] == '/' && line[i+1] == '/' {
            out = append(out, token{text: line[i:], color: "#6a9955"})
            break
        }
        // 字符串：到下一个未转义引号
        if line[i] == '"' {
            j := i + 1
            for j < len(line) && line[j] != '"' {
                if line[j] == '\\' && j+1 < len(line) { j = j + 1 }
                j = j + 1
            }
            if j < len(line) { j = j + 1 }
            out = append(out, token{text: line[i:j], color: "#ce9178"})
            i = j
            continue
        }
        // 标识符 / 关键字
        if isAlpha(line[i]) {
            j := i + 1
            for j < len(line) && isAlnum(line[j]) { j = j + 1 }
            w := line[i:j]
            c := "#d4d4d4"
            if isKeyword(w) { c = "#c586c0" }
            out = append(out, token{text: w, color: c})
            i = j
            continue
        }
        // 数字
        if line[i] >= '0' && line[i] <= '9' {
            j := i + 1
            for j < len(line) && isAlnum(line[j]) { j = j + 1 }
            out = append(out, token{text: line[i:j], color: "#b5cea8"})
            i = j
            continue
        }
        // 标点 / 空白：逐字节
        c := "#808080"
        if line[i] == ' ' || line[i] == '\t' { c = "#d4d4d4" }
        out = append(out, token{text: line[i : i+1], color: c})
        i = i + 1
    }
    return out
}

// ---- 编辑器视图（GX JSX，两端共用） ----

// 行级 token 缓存 + 一等细粒度版本集合。
//
// 演进史（性能主线）：
//   - 最初每个 token 一个 span + 2 个读 sourceCode 的 getter：8 行 × 24 槽 × 2
//     = 384 个 effect 全订阅整篇源码，插入一字符全量重跑（~88ms/键）。
//   - 引入行级版本信号后，订阅粒度细化到行：打字只 bump 变化行（~17ms/键）；
//     但切换示例是全量替换，所有行版本都 bump，仍有 ~200ms 卡顿。
//   - 现在把一行拆成"一个富文本节点"（rich-text 分段着色），每行的可变插槽从
//     48 降到 3。切换示例降到 ~10ms，打字降到 ~1.5ms。行版本用 signal.Vec
//     （一等细粒度集合）承载，替代了原先手写的 24 个 rowVerN 具名 sig。
//   - 继续优化：setSource 只重新分词变化行；富文本组件保留并合并同色 span，
//     但编辑器最终改用 CSS 渐变着色——每行一个文本属性 + 一个背景属性，
//     既无 innerHTML 也没有逐 token 节点/effect，且不受槽位上限截断。
//   - 本轮（切换优化）：静态样式从 style={{...}} 对象改回 kebab 直接属性，消掉
//     每行 flattenStyle 的 map 构造 + 反射（切换 177µs→61µs）；渐变/纯文本随
//     token 一起缓存，行 getter 只读缓存零分配（→48µs）；highlight 去掉
//     []byte 拷贝、改成 string 索引 + make 预分配（→43µs，分词 alloc 12→2）。
//
// tokenCache[i] 缓存第 i 行的分词结果；lineTextCache 保存对应的原文行；
// textCache/gradientCache 存派生出的纯文本与 CSS 渐变。setSource 比对新旧每行：
// 只有内容变化的行才重新分词并派生，未变行四份缓存全部复用。所有写 sourceCode
// 的编辑命令都改走 setSource，保证缓存与版本同步更新。
var tokenCache [][]token
var lineTextCache []string
// textCache/gradientCache 存每行的纯文本与 CSS 渐变，和 token 一起在
// rebuildTokenCache 里算好。行 getter 只读缓存，effect 重算时零分配。
var textCache []string
var gradientCache []string

// buildGradient 把一行的 token 颜色编码成 CSS linear-gradient 字符串。
func buildGradient(toks []token) string {
    var b strings.Builder
    b.WriteString("linear-gradient(90deg")
    pos := 0
    for _, t := range toks {
        w := runeWidth(t.text)
        if w == 0 { continue }
        b.WriteString(", ")
        b.WriteString(t.color)
        b.WriteString(" ")
        b.WriteString(strconv.itoa(pos))
        b.WriteString("ch ")
        b.WriteString(strconv.itoa(pos+w))
        b.WriteString("ch")
        pos = pos + w
    }
    b.WriteString(")")
    return b.String()
}

// joinLineText 拼回一行的原始文本。
func joinLineText(toks []token) string {
    var b strings.Builder
    for _, t := range toks { b.WriteString(t.text) }
    return b.String()
}

// rebuildTokenCache 按新行表刷新缓存：未变行复用旧 token/文本/渐变，变化行才算。
func rebuildTokenCache(lines []string) {
    oldLines := lineTextCache
    oldTokens := tokenCache
    oldText := textCache
    oldGrad := gradientCache
    nextLines := []string{}
    nextTokens := [][]token{}
    nextText := []string{}
    nextGrad := []string{}
    for i := 0; i < len(lines); i = i + 1 {
        line := lines[i]
        nextLines = append(nextLines, line)
        if i < len(oldLines) && oldLines[i] == line && i < len(oldTokens) {
            // 未变行：三份缓存都复用。
            nextTokens = append(nextTokens, oldTokens[i])
            if i < len(oldText) { nextText = append(nextText, oldText[i]) } else { nextText = append(nextText, joinLineText(oldTokens[i])) }
            if i < len(oldGrad) { nextGrad = append(nextGrad, oldGrad[i]) } else { nextGrad = append(nextGrad, buildGradient(oldTokens[i])) }
        } else {
            toks := highlight(line)
            nextTokens = append(nextTokens, toks)
            nextText = append(nextText, joinLineText(toks))
            nextGrad = append(nextGrad, buildGradient(toks))
        }
    }
    lineTextCache = nextLines
    tokenCache = nextTokens
    textCache = nextText
    gradientCache = nextGrad
}

// rowVersion 读第 idx 行版本：Vec.At(idx) 返回该行独立 sig，读它只订阅这一行。
// 24 个具名 sig + switch 分发的样板被一等细粒度集合替代。
func rowVersion(idx int) int {
    if idx < 0 { return 0 }
    if idx >= 24 { idx = 23 }
    s := rowVers.At(idx)
    if s == nil { return 0 }
    return s()
}

func bumpRow(idx int) {
    if idx < 0 { return }
    if idx >= 24 { idx = 23 }
    s := rowVers.At(idx)
    if s == nil { return }
    s(s() + 1)
}

// setSource 是写 sourceCode 的唯一入口：重算 token 缓存、只 bump 变化行版本、
// 并在一个 Batch 内写回 sourceCode（行数变化时 For 据此增删行）。
func setSource(text string) {
    ensureTokenCache()
    oldLines := lineTextCache
    newLines := splitLines(text)
    // 只重新分词变化行，未变行复用缓存。
    rebuildTokenCache(newLines)
    Signal.batch(func() {
        for i := 0; i < len(newLines); i = i + 1 {
            // 新行或内容变化的行才 bump；未变行的 token getter 不重跑。
            if i >= len(oldLines) || oldLines[i] != newLines[i] {
                bumpRow(i)
            }
        }
        lineCount = len(newLines)
        sourceCode = text
    })
}

// EditorLineText 导出给装配层诊断/集成用：读第 idx 行第 slot 个 token 文本。
pub func EditorLineText(idx int, slot int) string {
    _ = rowVersion(idx)
    ensureTokenCache()
    if idx < 0 || idx >= len(tokenCache) { return "" }
    toks := tokenCache[idx]
    if slot < 0 || slot >= len(toks) { return "" }
    return toks[slot].text
}

// 懒初始化：首次渲染时 tokenCache 尚未由 setSource 建立（初始 sourceCode
// 是包级 sig 字面量，未经编辑命令），此时读一次 sourceCode 全量搭表，保证首帧有内容。
func ensureTokenCache() {
    if tokenCache != nil { return }
    s := sourceCode
    lines := splitLines(s)
    rebuildTokenCache(lines)
    lineCount = len(lines)
}

// 每行只保留两个 getter：纯文本 + 颜色渐变。语法高亮不用富文本组件，也不给
// 每个 token 建节点/effect，而是把逐 token 颜色编码成 CSS linear-gradient：
// 等宽字体下一个字符宽度是 1ch（CJK 按 2ch 估算），渐变色标落在 token 边界上，
// 再由页面 CSS 的 background-clip:text 把渐变裁到文字本身。于是着色更新 =
// 每行 1 个背景属性，effect 数从 O(行×token) 降到 O(行)，且不存在槽位上限截断。
func runeWidth(s string) int {
    n := 0
    for _, r := range s {
        if r >= 0x2e80 { n = n + 2 } else { n = n + 1 }
    }
    return n
}

func lineText(idx int) string {
    _ = rowVersion(idx)
    ensureTokenCache()
    if idx < 0 || idx >= len(textCache) { return "" }
    return textCache[idx]
}

func lineCodeGradient(idx int) string {
    _ = rowVersion(idx)
    ensureTokenCache()
    if idx < 0 || idx >= len(gradientCache) { return "" }
    return gradientCache[idx]
}

// lineRich 返回第 idx 行的着色分段，供两端后端原生渲染语法高亮：
// web 后端一次 innerHTML 写入带内联 color 的 span，skia 后端逐段着色。
// 每行只占 1 个属性插槽，订阅本行版本（本行变化才重算），token 直接复用缓存。
func lineRich(idx int) gxscene.RichText {
    _ = rowVersion(idx)
    ensureTokenCache()
    out := gxscene.RichText{}
    if idx < 0 || idx >= len(tokenCache) { return out }
    for _, t := range tokenCache[idx] {
        out = append(out, gxscene.RichSpan{Text: t.text, Color: t.color})
    }
    return out
}

// lineGutterColor 与整行同色：行号列不再用独立背景块，避免视觉上把编辑器割成两条。
// 光标行用左侧强调条（border-left）表达，背景仍与整行一致。
func lineGutterColor(idx int) string {
    return lineRowBg(idx)
}

func lineRowBg(idx int) string {
    if idx == cursorLine && editorFocused { return "#2a2d3a" }
    return "#1e1e1e"
}

func lineNumber(idx int) string { return strconv.itoa(idx + 1) }

// lineView 渲染一行：行号 + 一个代码 span。
//
// 编辑器刻意不使用富文本组件：每行只有两个 getter（纯文本 + 颜色渐变），
// 颜色由 lineCodeGradient 编码进 CSS linear-gradient，页面 CSS 用
// background-clip:text 裁到文字上。性能来自四层：行版本隔离（只重算变化行）、
// token 缓存复用（未变行不重新分词）、固定 24 行（动态新增行会漏叶子订阅）、
// 批量 + RAF 提交（一次交互只打一帧 DOM 补丁）。
func lineView(idx int) *gxscene.Instance {
    // 样式优先用直接属性（kebab key）走标量快路径。若需收进 style={{...}}，
    // 驼峰 key 编译为 gxscene.Style 的强类型字段，伪状态用单词 key（hover 等）。
    // 这里刻意不用 style 对象：它每次 effect 重算都要构造 Style + 展平 props，是切换热点。
    // 固定行高 22px + flex-shrink:0：父容器是定高 flex column，若不锁行高会被
    // 压缩到 ~13px，行号（padding+字号）与代码 span 各按自身高度居中就会错位。
    // 行号与代码都用 line-height:22px 统一基线，diff 恒为 0（含空行/中文/注释）。
    // 隐藏行 height=0 + overflow:hidden 裁掉内容，不占空间。
    // 整行（含行号槽 + 代码后的空白）都带 gx-editor-row：点击落在空行或行尾
    // 空白处时前端用 closest 命中这一层拿行号，代码列仍交给 wasm 的 pickColumn。
    return <div
        class="gx-editor-row"
        bg={lineRowBg(idx)}
        height={rowHeight(idx)}
        overflow="hidden"
        flex-shrink="0"
        flex-direction="row"
        align-items="center"
    >
        <div
            bg={lineGutterColor(idx)}
            color="#858585"
            width="42"
            font-size="12"
            height="22"
            line-height="22px"
            margin-right="8"
            flex-shrink="0"
            text-align="right"
        >
            {lineNumber(idx)}
        </div>
        <span
            class="gx-code-line"
            data-code={lineText(idx)}
            rich-text={lineRich(idx)}
            white-space="pre"
            font-size="13"
            height="22"
            line-height="22px"
            flex-shrink="0"
            color="#d4d4d4"
        >
            {lineText(idx)}
        </span>
    </div>
}

// selectionView 选区色块：绝对定位。两端渲染顺序不同：web 端由 CSS 分层（色块
// z-index=1、代码提到 2、caret 保持 6），色块在文字之下可用不透明标准色；
// skia 后端不识别 z-index、按树序绘制（色块在行之后 → 盖在文字上），所以源码里
// 用 8 位 hex 半透明 #264f7899（parseColor 支持 #rrggbbaa）保文字可读，
// web 端再由页面 CSS 的 background-color !important 覆盖回不透明 #264f78。
func selectionView(idx int) *gxscene.Instance {
    return <div
        class="gx-sel"
        position="absolute"
        top={selRectTop(idx)}
        left={selRectLeft(idx)}
        width={selRectWidth(idx)}
        height="22"
        bg={selRectBg(idx)}
        z-index="1"
    />
}

// 固定 24 行：For 的 each 是常量，所有行在首帧就完成叶子 effect 绑定。
// 行数变化只改每行的高度（超出部分高度 0），不再动态新增/删除行——
// 动态新增行在 Web 增量后端会漏掉叶子订阅，导致切换示例后尾部行保留旧内容。
var editorRowIDs = indices(24)

func rowHeight(idx int) int {
    if idx < lineCount { return 22 }
    return 0
}

// Editor 渲染整个编辑器。每行文本/颜色/高亮走行版本 getter，内容变化才精确刷新。
pub func Editor() *gxscene.Instance {
    // 可视高度 22×14=308px，超出 24 行可滚动；overflow:auto 让长示例（含
    // package/import 的展示版）超出部分可达，而不是被父容器裁掉无法编辑。
    // position="relative"：caret 是绝对定位子节点，左上角相对本容器；容器滚动时
    // 绝对子节点随内容一起滚动（与 Ace 把 cursor layer 放进 scroller 同理）。
    return <div
        bg="#1e1e1e"
        border-radius="8"
        padding="6"
        flex-direction="column"
        gap="0"
        height="470"
        overflow="auto"
        position="relative"
    >
        <For each={editorRowIDs}>{(i int) => lineView(i())}</For>
        <For each={editorRowIDs}>{(i int) => selectionView(i())}</For>
        <div
            class={caretClass()}
            position="absolute"
            left={caretLeft()}
            top={caretTop()}
            width="2"
            height="22"
            bg="#aeafad"
            z-index="6"
        />
    </div>
}

// EditorStatus 返回编辑器状态栏文本（行列 + 行数），供 playground 头部展示。
pub func EditorStatus() string {
    s := "Ln " + strconv.itoa(cursorLine+1) + ", Col " + strconv.itoa(cursorCol+1) +
         "  |  " + strconv.itoa(lineCount) + " lines"
    if hasSelection() {
        s = s + "  |  " + strconv.itoa(runeLen(editorSelectedText())) + " selected"
    }
    return s
}
