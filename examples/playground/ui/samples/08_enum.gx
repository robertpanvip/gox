// enum 枚举：类型 + 常量 + String() + Parse<T>()，三种拼写指向同一符号
pub enum color string { red = "#ef4444", green = "#22c55e", blue = "#3b82f6" }
sig idx = 0
func next() { idx = (idx + 1) % 3 }
func view() *gxscene.Instance {
    cs := []color{colorRed, colorGreen, colorBlue}
    c := cs[idx]
    return <div style={{ flexDirection: "column", gap: 8 }}>
        <button onClick={next} style={{ padding: 8 }}>换色</button>
        <div style={{ background: string(c), padding: 20, borderRadius: 8, color: "#fff" }}>
            {c}
        </div>
    </div>
}
