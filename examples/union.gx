// 联合类型示例：GX 把类型位置的 A|B|C 擦除为 Go 的 any，
// 配合 is 守卫在分支内窄化为具体类型。
package main

import "fmt"

// 参数声明为联合类型 int|string|bool，生成 Go 后是 any，
// 并在函数入口自动插入运行时的 type switch 守卫：传入非这三类值会 panic。
// 函数体内再用 is 守卫逐个窄化，并用 else 覆盖剩余成员（穷尽）。
pub func describe(v int | string | bool) string {
    if (v is int) {
        return fmt.sprint("int:", v+100)
    } else if (v is string) {
        return fmt.sprint("str:", v)
    } else {
        // 此分支 v 已排除 int/string，剩余 bool。
        // 注意：else 分支 desugar 不注入 shadow，此处不要对 v 做运算。
        return "bool"
    }
}

// 类型别名里的联合同样擦除为 any。
type Num = int | float64

func main() {
    fmt.println(describe(42))
    fmt.println(describe("hi"))
    fmt.println(describe(true))

    var n Num = 3.5
    fmt.println(n)
}
