// 应用级入口 gxapp.Open — 类比 ReactDOM.render：把 JSX 挂到「窗口」上。
// 构建：gox build examples/jsxapp.gx -jsx=scene -o main.go && go run .
//
// gxapp.Open 的两个参数正好是：
//   第一个参数：JSX（编译后即 gxscene.Render(...) → *Instance）
//   第二个参数：窗口配置 gxapp.WindowConfig（标题、尺寸、位置等）
//
// 窗口后端由 Window 接口抽象。第一版内置 Headless（TextBackend 绘制到终端）；
// Skia / wgpu / GLFW 后端实现同一接口即可接入，app 层与编译器无需改动。
package main

import (
    gxapp "github.com/robertpanvip/gox/runtime/app"
    "github.com/robertpanvip/gox/runtime/signal"
)

func main() {
    // signal 响应式：signal 变化由 app.BindReactive 自动更新场景树并重绘窗口。
    signal count = 0
    let doubled = Signal.computed(func() int { return count() * 2 })

    view := <div id="app">
        <h1>Counter</h1>
        <span>count = {count}</span>
        <b>doubled = {doubled}</b>
    </div>

    // 打开窗口：第一个参数是 JSX（场景树），第二个是窗口配置。
    // 返回 (*App, error)：窗口后端创建失败时报错（Headless 不会失败）。
    app, err := gxapp.Open(view, gxapp.WindowConfig{
        Title:  "Gox Counter",
        Width:  800,
        Height: 600,
    })
    if err != nil {
        panic(err)
    }
    defer app.Close()

    // 一行接线：signal 变化 → 精确更新插槽 → 自动重绘窗口（无需手动 Update/Draw）。
    app.BindReactive(signal.Effect)

    // count = 5 后，count 与 doubled 两行自动刷新到新帧。
    count = 5
}
