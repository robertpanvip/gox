package main

import (
	gxscene "github.com/robertpanvip/gox/runtime/scene"
	"fmt"
)

// Card 是一个复合组件：签名 func(gxscene.Props) *gxscene.Instance。
// 函数体里的 JSX 被编译成 gxscene opcode 模板 + getter。组件只在首次渲染时
// 调用一次，动态属性以 getter 传入（gxscene.Get），因此外部数据变化后，
// 靠父级 Update() 递归驱动本组件做细粒度更新。
 func Card(props gxscene.Props) *gxscene.Instance {
	title := gxscene.Get[string](props, "title")
	n := gxscene.Get[int](props, "n")
	return gxscene.Render(gxscene.Template{Ops:[]gxscene.Op{gxscene.Op{Code:gxscene.OpElem,Arg:"div",},gxscene.Op{Code:gxscene.OpAttr,Arg:"card",Key:"class",},gxscene.Op{Code:gxscene.OpElem,Arg:"h1",},gxscene.Op{Code:gxscene.OpDynChild,Slot:0,},gxscene.Op{Code:gxscene.OpClose,},gxscene.Op{Code:gxscene.OpElem,Arg:"span",},gxscene.Op{Code:gxscene.OpDynChild,Slot:1,},gxscene.Op{Code:gxscene.OpClose,},gxscene.Op{Code:gxscene.OpClose,},},N:2,}, func() any{ return title() }, func() any{ return n() })
}

func main() {
	title := "GX"
	count := 1

	// 用 JSX 组合复合组件：外层 div 里嵌一个 <Card/>。
	// 编译后 Card 处是 OpComp 插槽 + 一次 Card(gxscene.Props{...}) 调用；
	// 动态属性包成 getter，读的是变量本身而非快照。
	view := gxscene.Render(gxscene.Template{Ops:[]gxscene.Op{gxscene.Op{Code:gxscene.OpElem,Arg:"div",},gxscene.Op{Code:gxscene.OpAttr,Arg:"app",Key:"id",},gxscene.Op{Code:gxscene.OpComp,Arg:"Card",Slot:0,},gxscene.Op{Code:gxscene.OpClose,},},N:1,}, func() any{ return Card(gxscene.Props{"title":func() any{ return title },"n":func() any{ return count },}) })

	// 首次渲染：clone 缓存骨架，挂载 Card 子树，得到常驻场景树
	fmt.Println(view)

	// 数据变化：父 Update 递归驱动 Card 的子插槽，只写变化的节点（零 Diff、零整树重建）
	title = "Gox"
	count = 2
	fmt.Println("写入节点数:", view.Update())
	fmt.Println(view)
}
