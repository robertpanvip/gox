// gx:nocollections
// 本文件为原生 Go 组件源码，经 gox build 转译为 popover.go。
// gx:nocollections 声明跳过集合/裸对象字面量 desugar，保留手写 opcode 的原生 Go 语义。
package widgets

// Popover 浮层组件——下拉菜单/Select/Dropdown/Tooltip 的共同底座。
//
// 它把「锚点 + 遮罩 + 浮层」组合成一棵场景树，并用条件分支（OpBranch）在 open
// 变化时动态挂载/卸载浮层子树。所有定位语义都编码进 gx-* 属性由后端解释
// （见 backend/skia/overlay.go 与 rust/src/render.rs），host 与组件库零侵入。
//
// 场景树结构：
//
//	#frag (Popover)
//	├── div[gx-anchor-id]        ← 锚点包装（trigger 子树挂在其下，矩形贴合 trigger）
//	│   └── <trigger subtree>    (OpComp slot 0)
//	└── #frag (OpBranch slot 1)  ← selector = open ? 1 : 0
//	    ├── [1] div[gx-role=scrim, onClick=close]   ← 全屏遮罩，点外部关闭
//	    │       div[gx-role=popover, gx-anchor, gx-placement, gx-offset]
//	    │       └── <content subtree> (builder 内 Render)
//	    └── [0] (空)
//
// 用法（非受控，内部状态）：
//
//	state := widgets.NewPopoverState()
//	widgets.Popover(Props{
//	    "state": state,
//	    "placement": "bottom-start",
//	    "trigger": func() any { return widgets.Button(Props{"label": "Open"}) },
//	    "content": func() any { return myMenu },
//	})
//	// 业务在别处：state.Toggle()
//
// 受控模式：传 "open" (func() bool) + "onOpenChange" (func(bool)) 代替 "state"。
import (
	"strconv"
	"sync/atomic"

	gxscene "github.com/robertpanvip/gox/runtime/scene"
	"github.com/robertpanvip/gox/runtime/signal"
)

var popoverSeq atomic.Uint64

// PopoverState 是 Popover 的开关状态，内部持有一个 bool signal。
// 业务持有它即可在任意位置打开/关闭浮层（如选中菜单项后关闭）。
type PopoverState struct {
	open signal.Signal[bool]
}

func NewPopoverState(initial bool) *PopoverState {
	return &PopoverState{open: signal.new(initial)}
}

func (s *PopoverState) Open()             { s.open(true) }
func (s *PopoverState) Close()            { s.open(false) }
func (s *PopoverState) Toggle()           { s.open(!s.open()) }
func (s *PopoverState) Set(v bool)        { s.open(v) }
func (s *PopoverState) IsOpen() bool      { return s.open() }
// Getter 返回可用于 JSX 插值的 bool getter。
func (s *PopoverState) Getter() func() bool { return func() bool { return s.open() } }

// Popover 构造一个浮层组件实例。
// Props:
//   - state        *PopoverState（非受控；与 open/onOpenChange 二选一）
//   - open         func() bool（受控开关）
//   - onOpenChange func(bool)（受控变更回调）
//   - trigger      func() any → 返回 *gxscene.Instance（触发按钮子树）
//   - content      func() any → 返回 *gxscene.Instance（浮层内容子树）
//   - placement    string（bottom-start / bottom / top-start ...）
//   - offset       string（像素，缺省 "6"）
//   - width        string（浮层宽度，缺省按内容）
func Popover(props gxscene.Props) *gxscene.Instance {
	uid := "popover-" + strconv.formatUint(popoverSeq.Add(1), 10)

	stateGet := gxscene.get[*PopoverState](props, "state")
	openGet := gxscene.get[bool](props, "open")
	placement := gxscene.get[string](props, "placement")
	offset := gxscene.get[string](props, "offset")
	width := gxscene.get[string](props, "width")
	triggerGet := gxscene.get[any](props, "trigger")
	contentGet := gxscene.get[any](props, "content")

	// 变更回调：受控模式调业务 onOpenChange；非受控模式写内部 state。
	setOpen := func(v bool) {
		if st := stateGet(); st != nil {
			st.Set(v)
		}
		if cb, ok := props["onOpenChange"].(func(bool)); ok && cb != nil {
			cb(v)
		}
	}
	isOpen := func() bool {
		if st := stateGet(); st != nil {
			return st.IsOpen()
		}
		return openGet()
	}

	// 插槽：0=trigger(OpComp), 1=浮层开关(OpBranch), 2=content(OpComp 在 branch builder 内另建，见下)。
	const (
		triggerSlot = iota
		branchSlot
		nSlots
	)

	ops := []gxscene.Op{
		// 根透明包装
		{Code: gxscene.opElem, Arg: "div"},
		{Code: gxscene.opAttr, Key: "gx-role", Arg: "anchor"},
		{Code: gxscene.opAttr, Key: "gx-anchor-id", Arg: uid},
		{Code: gxscene.opAttr, Key: "flex-direction", Arg: "column"},
		// trigger 子组件挂在此 div 下
		{Code: gxscene.opElem, Arg: "div"},
		{Code: gxscene.opComp, Arg: "PopoverTrigger", Slot: triggerSlot},
		{Code: gxscene.opClose},
		// 浮层开关分支
		{Code: gxscene.opBranch, Slot: branchSlot},
		{Code: gxscene.opClose},
	}

	// content getter 返回 *Instance；在 branch builder 内重建子树，其内部 signal 由
	// Branch 的 CreateRoot + bindStructure 自动接线（见 branch.go Resolve）。
	buildContent := func() *gxscene.Instance {
		v := contentGet()
		if inst, ok := v.(*gxscene.Instance); ok {
			return inst
		}
		return nil
	}
	buildTrigger := func() *gxscene.Instance {
		v := triggerGet()
		if inst, ok := v.(*gxscene.Instance); ok {
			return inst
		}
		return nil
	}

	// branch 选择器：open ? 1(浮层) : 0(空)
	// 注意：OpBranch 插槽需要 *gxscene.Branch 控制器本身（不是 BranchGetter 的 getter），
	// 由 Render 的 applyAll 在响应式接线时调用其 Resolve 动态挂载子树。
	branch := gxscene.newBranch(
		func() int {
			if isOpen() {
				return 1
			}
			return 0
		},
		// [0] 关闭：空子树
		func() *gxscene.Instance { return nil },
		// [1] 打开：遮罩 + 浮层
		func() *gxscene.Instance {
			p := "bottom-start"
			if v := placement(); v != "" {
				p = v
			}
			off := "6"
			if v := offset(); v != "" {
				off = v
			}
			floatOps := []gxscene.Op{
				// 遮罩：全屏，点击关闭
				{Code: gxscene.opElem, Arg: "div"},
				{Code: gxscene.opAttr, Key: "gx-role", Arg: "scrim"},
				{Code: gxscene.opEvent, Key: "onClick", Slot: 0},
				{Code: gxscene.opClose},
				// 浮层内容
				{Code: gxscene.opElem, Arg: "div"},
				{Code: gxscene.opAttr, Key: "gx-role", Arg: "popover"},
				{Code: gxscene.opAttr, Key: "gx-anchor", Arg: uid},
				{Code: gxscene.opAttr, Key: "gx-placement", Arg: p},
				{Code: gxscene.opAttr, Key: "gx-offset", Arg: off},
				{Code: gxscene.opAttr, Key: "bg", Arg: AppleMaterialReg},
				{Code: gxscene.opAttr, Key: "border-radius", Arg: RadiusCard},
				{Code: gxscene.opAttr, Key: "border", Arg: AppleHairline},
				{Code: gxscene.opAttr, Key: "border-width", Arg: "1"},
				{Code: gxscene.opAttr, Key: "box-shadow", Arg: ShadowFloat},
				{Code: gxscene.opAttr, Key: "flex-direction", Arg: "column"},
				{Code: gxscene.opAttr, Key: "padding", Arg: "6"},
			}
			if w := width(); w != "" {
				floatOps = append(floatOps, gxscene.Op{Code: gxscene.opAttr, Key: "width", Arg: w})
			}
			// content 子树：用 OpComp 挂在浮层 div 下（在 builder 内静态构造，slot 0 局部于本 builder 的模板）
			floatOps = append(floatOps,
				gxscene.Op{Code: gxscene.opElem, Arg: "div"},
				gxscene.Op{Code: gxscene.opComp, Arg: "PopoverContent", Slot: 1},
				gxscene.Op{Code: gxscene.opClose},
				gxscene.Op{Code: gxscene.opClose},
			)
			return gxscene.render(gxscene.Template{Ops: floatOps, N: 2},
				// slot 0: scrim onClick → 关闭（事件 getter 返回 handler 原值）
				func() any {
					return gxscene.Handler(func(gxscene.EventContext) { setOpen(false) })
				},
				// slot 1: content 子树
				func() any { return buildContent() },
			)
		},
	)

	return gxscene.render(gxscene.Template{Ops: ops, N: nSlots},
		// slot 0: trigger 子树
		func() any { return buildTrigger() },
		// slot 1: 分支控制器
		func() any { return branch },
	)
}
