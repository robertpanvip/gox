package widgets

import (
	"fmt"
	gxscene "github.com/robertpanvip/gox/runtime/scene"
	"strings"
)

// ---- 内置终端面板（Console）----
//
// 一个苹果风格的输出终端组件：程序内的 println / print / 日志输出统一显示
// 在这里，替代「输出没有地方看」的窘境。与 gox-term（独立桌面 shell 程序）
// 不同，这是**进程内输出面板**——不跑 shell、不占 PTY，纯展示 + 可订阅：
//
//   - Print / Println / Printf：写入缓冲并触发面板刷新（sig 驱动）
//   - OnOutput：输出钩子——web 装配层可借此把同一份输出转发到浏览器
//     DevTools console（桌面端可转发到系统日志）
//   - RunMark：加分隔行，标记一段输出的来源（playground 每次 Run 一条）
//   - Clear：清屏
//
// 缓冲按 maxLines 环形裁剪（默认 500 行），长时间输出不会无限膨胀。
// 多实例隔离：每个 TerminalState 互不共享，可在同一 App 内并存多个。

type TerminalState struct {
	sig      text string
	onOutput func(string)
	maxLines int
}

// NewTerminal 创建一个终端实例。
func NewTerminal() *TerminalState {
	return &TerminalState{maxLines: 500, text: ""}
}

// OnOutput 注册输出钩子（非响应式：注册发生在建树前，不参与渲染）。
// fn 收到的文本与 Print 写入的内容一致（含换行），nil 解除钩子。
func (s *TerminalState) OnOutput(fn func(string)) {
	s.onOutput = fn
}

// Print 追加文本（不自动换行）。触发面板刷新与输出钩子。
func (s *TerminalState) Print(text string) {
	if text == "" {
		return
	}
	s.text = s.text + text
	s.trim()
	if s.onOutput != nil {
		s.onOutput(text)
	}
}

// Println 追加一行。
func (s *TerminalState) Println(text string) {
	s.Print(text + "\n")
}

// Printf 按 fmt 语义格式化后追加：%v/%d/%s/%t 按 %v 规则展开（fmt.Sprintf）。
func (s *TerminalState) Printf(format string, args ...any) {
	s.Print(fmt.sprintf(format, args...))
}

// RunMark 写一条分隔行，标记一段输出的起点（如每次 Run）。
func (s *TerminalState) RunMark(label string) {
	s.Print("── " + label + " ──\n")
}

// Clear 清屏。
func (s *TerminalState) Clear() {
	s.text = ""
}

// Text 返回当前缓冲全文（测试/导出用）。
func (s *TerminalState) Text() string {
	return s.text
}

// LineCount 返回当前内容行数（标题栏展示）：非空内容至少 1 行，
// 末尾不带换行的残行也计入。
func (s *TerminalState) LineCount() int {
	t := s.text
	if t == "" {
		return 0
	}
	n := strings.count(t, "\n")
	if !strings.hasSuffix(t, "\n") {
		n++
	}
	return n
}

// trim 按 maxLines 裁剪：保留最后 N 行。
func (s *TerminalState) trim() {
	n := s.maxLines
	if n <= 0 {
		return
	}
	for i := 0; i < 8; i++ { // 多裁一轮防御长粘贴
		lines := strings.count(s.text, "\n")
		if lines <= n {
			return
		}
		idx := indexNthNewline(s.text, lines-n+1)
		if idx < 0 {
			return
		}
		s.text = s.text[idx+1:]
	}
}

// indexNthNewline 返回第 nth 个 '\n' 的下标（nth 从 1 起），找不到返回 -1。
func indexNthNewline(s string, nth int) int {
	count := 0
	for i := 0; i < len(s); i++ {
		if s[i] == '\n' {
			count++
			if count == nth {
				return i
			}
		}
	}
	return -1
}

// ---- 视图 ----

// Terminal 渲染终端面板。props:
//
//	state  *TerminalState  必填：终端实例
//	height string          内容区高度（CSS 值，默认 "160"）
//	title  string          标题（默认 "Console"）
//	collapsed bool         初始收起（只显示标题栏）
func Terminal(props gxscene.Props) *gxscene.Instance {
	state := gxscene.get[*TerminalState](props, "state")
	height := gxscene.get[string](props, "height")
	title := gxscene.get[string](props, "title")

	h := height()
	if h == "" {
		h = "160"
	}
	t := title()
	if t == "" {
		t = "Console"
	}

	// 行数徽标（sig 驱动：每次输出刷新）。
	ops := []gxscene.Op{
		el("div"), attr("flex-direction", "column"), attr("gap", "0"),
		attr("border-radius", RadiusCard), attr("overflow", "hidden"),
		attr("border-width", HairlineWidth), attr("border", "#3a3f4b"),
		attr("box-shadow", "0 1 4 rgba(0,0,0,0.25)"),
		// 标题栏：traffic lights + 标题 + 行数
		el("div"), attr("flex-direction", "row"), attr("gap", "8"), attr("padding", "6 10"),
		attr("bg", "#2a2e37"), attr("align-items", "center"),
		el("div"), attr("size", "8"), attr("bg", "#ff5f57"), attr("border-radius", "4"), closeEl(),
		el("div"), attr("size", "8"), attr("bg", "#febc2e"), attr("border-radius", "4"), closeEl(),
		el("div"), attr("size", "8"), attr("bg", "#28c840"), attr("border-radius", "4"), closeEl(),
		el("span"), attr("font-size", FontFootnote), attr("weight", "bold"), attr("color", "#8b919e"),
		dynChild(titleSlotIdx), closeEl(),
		el("span"), attr("font-size", FontFootnote), attr("color", "#5d6470"),
		dynChild(linesSlotIdx), closeEl(),
		closeEl(),
		// 内容区：深色底、等宽、pre 保留换行
		el("div"), attr("bg", "#1d2129"), attr("padding", "8 10"),
		attr("height", h), attr("overflow", "auto"),
		attr("white-space", "pre"), attr("font-family", terminalFontFamily),
		attr("font-size", FontFootnote), attr("color", "#a8d8b9"),
		dynChild(textSlotIdx), closeEl(),
		closeEl(),
	}

	return gxscene.render(gxscene.Template{Ops: ops, N: 3},
		func() any { return t },
		func() any {
			if st := state(); st != nil {
				return fmt.sprintf("%d 行", st.LineCount())
			}
			return ""
		},
		func() any {
			if st := state(); st != nil {
				return st.Text() // 方法读：Text 内部走 sig 读（避免 getter 闭包内跨变量 sig 字段推断缺口）
			}
			return ""
		},
	)
}

// 终端面板的动态槽位（与 Terminal 中的 ops 序列严格对应）。
const (
	titleSlotIdx = 0
	linesSlotIdx = 1
	textSlotIdx  = 2
)

// terminalFontFamily 终端等宽字体栈。
const terminalFontFamily = "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
