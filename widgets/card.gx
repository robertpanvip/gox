package widgets

// Card 预制卡片：深色面板 + 细描边 + 柔和阴影 + 可选标题与任意子节点。
// 本组件用 GX 语言（JSX）编写，经 gox build 转译为 card.go 后供 Go 工具链编译。
// 这是 widgets 标准库"用 GX 自身书写"的样板组件。
//
// props:
//
//	title    标题文本（可传 getter）
//	width    宽度
//	padding  内边距（默认 16）
//	tone     标题强调色
//	children 子节点（gxscene.Child）
import gxscene "github.com/robertpanvip/gox/runtime/scene"

pub func Card(props gxscene.Props) *gxscene.Instance {
	title := gxscene.get[string](props, "title")
	width := gxscene.get[string](props, "width")
	padding := gxscene.get[string](props, "padding")
	tone := gxscene.get[string](props, "tone")
	children := gxscene.child(props)

	pad := padding()
	if pad == "" {
		pad = "16"
	}

	// 标题行 + 内容区。标题为空时仍保留空 span 占位，维持稳定的插槽结构。
	return <div gx-role="card" bg={ThemePanel} border={ThemeBorder} border-width="1"
		border-radius={RadiusCard} box-shadow={ShadowCard} padding={pad}
		flex-direction="column" gap="8" width={width()}>
		<span color={toneColor(tone())} font-size="12" weight="bold">{title()}</span>
		<span>{children()}</span>
	</div>
}
