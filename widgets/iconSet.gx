	svgWarning = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L22 20 L2 20 Z M12 9 L12 14 M12 17 L12 17.2"/></svg>`
