	svgDownload = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L12 16 M7 11 L12 16 L17 11 M4 20 L20 20"/></svg>`
