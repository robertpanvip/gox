	svgStar = `<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2 L15 9 L22 9.5 L17 14 L18.5 21 L12 17.5 L5.5 21 L7 14 L2 9.5 L9 9 Z"/></svg>`
