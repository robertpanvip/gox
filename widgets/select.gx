// gx:nocollections
// 本文件为原生 Go 组件源码，经 gox build 转译为 select.go。
// gx:nocollections 声明跳过集合/裸对象字面量 desugar，保留手写 opcode 的原生 Go 语义。
package widgets

import (
	gxscene "github.com/robertpanvip/gox/runtime/scene"
)

// Select 下拉选择器——基于 Popover 浮层底座实现，是 Select/Dropdown/Menu 的
// 通用形态。它把"当前值展示 + 点击展开 + 选项列表 + 选中关闭"封装成一个组件，
// 业务只需提供 value / options / onChange。
//
// Props:
//
//	value       func() string      当前选中值
//	options     []Option 等        候选项（见 optionsFrom 支持的形态）
//	onChange    Handler            变更回传，用 BindValue 包装
//	placeholder string             未选中时的占位文字（默认 "请选择"）
//	width       string             触发器宽度（默认 200）
//	menu-width  string             菜单宽度（默认与触发器相同）
//	tone        强调色
//	placement   浮层位置（默认 bottom-start，透传给 Popover）
//	state       *PopoverState      可选：外部持有浮层开关（默认内部新建）
//	disabled    bool               禁用
//
// 结构：
//
//	Popover
//	├── trigger: 按钮（显示选中 label + 下拉箭头）
//	└── content: 菜单（OpFor 选项，每项点击 → onChange + 关闭浮层）
func Select(props gxscene.Props) *gxscene.Instance {
	value := gxscene.get[string](props, "value")
	options := optionsFrom(props, "options")
	onChange := gxscene.get[gxscene.Handler](props, "onChange")
	placeholder := gxscene.get[string](props, "placeholder")
	width := gxscene.get[string](props, "width")
	menuWidth := gxscene.get[string](props, "menu-width")
	tone := gxscene.get[string](props, "tone")
	placement := gxscene.get[string](props, "placement")
	disabled := gxscene.get[bool](props, "disabled")
	stateGet := gxscene.get[*PopoverState](props, "state")

	ph := placeholder()
	if ph == "" {
		ph = "请选择"
	}
	w := width()
	if w == "" {
		w = "200"
	}
	mw := menuWidth()
	if mw == "" {
		mw = w
	}
	pl := placement()
	if pl == "" {
		pl = "bottom-start"
	}
	st := stateGet()
	if st == nil {
		st = NewPopoverState(false)
	}

	// trigger：显示当前选中 label。
	trigger := func() any { return selectTrigger(value, options(), ph, w, tone(), disabled()) }
	// content：菜单列表。点击选项 → 回传 + 关闭。
	content := func() any {
		return selectMenu(value, options, onChange, st, mw)
	}

	return Popover(gxscene.Props{
		"state":     func() any { return st },
		"placement": func() any { return pl },
		"trigger":   trigger,
		"content":   content,
	})
}

func selectTrigger(value func() string, options []Option, placeholder, width, tone string, disabled bool) *gxscene.Instance {
	const (
		textSlot = iota
		colorSlot
		chevronSlot
		nSlots
	)
	ops := []gxscene.Op{
		el("div"), attr("gx-role", "select-trigger"),
		attr("width", width), attr("bg", ThemeInputBg),
		attr("border", ThemeBorder), attr("border-width", "1"),
		attr("border-radius", RadiusControl), attr("padding", "6"), attr("height", ControlHeight),
		attr("flex-direction", "row"), attr("align-items", "center"),
		attr("justify-content", "space-between"), attr("gap", "8"), attr("opacity", "1"),
		dynAttr("color", colorSlot),
		el("span"), attr("font-size", FontBody), dynChild(textSlot), closeEl(),
		// 下拉箭头用预制矢量图标（chevron-down），替代 "▾" 字形。
		gxscene.Op{Code: gxscene.opComp, Arg: "SelectChevron", Slot: chevronSlot},
		closeEl(),
	}
	if disabled {
		// 覆盖静态 opacity（后置属性生效）——用动态插槽更稳，这里直接改静态值。
		for i := range ops {
			if ops[i].Code == gxscene.opAttr && ops[i].Key == "opacity" {
				ops[i].Arg = "0.5"
			}
		}
	}
	labelOf := func() string {
		v := value()
		for _, o := range options {
			if o.Value == v {
				return optionLabel(o)
			}
		}
		return placeholder
	}
	return gxscene.render(gxscene.Template{Ops: ops, N: nSlots},
		func() any { return labelOf() },
		func() any {
			if value() == "" {
				return ThemeMuted
			}
			return ThemeText
		},
		func() any { return iconNode("chevron-down", 14, "muted") },
	)
}

func selectMenu(value func() string, options func() []Option, onChange func() gxscene.Handler, st *PopoverState, width string) *gxscene.Instance {
	forCtl := gxscene.newFor(
		func() []any {
			os := options()
			out := make([]any, len(os))
			for i, o := range os {
				out[i] = o
			}
			return out
		},
		func(v any) any { return v.(Option).Value },
		func(v any) *gxscene.Instance {
			return selectOptionItem(v.(Option), value, onChange, st)
		},
	)
	ops := []gxscene.Op{
		el("div"), attr("gx-role", "select-menu"),
		attr("flex-direction", "column"), attr("gap", "2"),
		attr("width", width), attr("padding", "4"),
		gxscene.Op{Code: gxscene.opFor, Slot: 0},
		closeEl(),
	}
	return gxscene.render(gxscene.Template{Ops: ops, N: 1},
		func() any { return forCtl },
	)
}

func selectOptionItem(o Option, value func() string, onChange func() gxscene.Handler, st *PopoverState) *gxscene.Instance {
	selected := func() bool { return value() == o.Value }
	const (
		clickSlot = iota
		bgSlot
		colorSlot
		checkSlot
		nSlots
	)
	ops := []gxscene.Op{
		el("div"), attr("gx-role", "select-option"),
		attr("flex-direction", "row"), attr("align-items", "center"),
		attr("justify-content", "space-between"), attr("gap", "8"),
		attr("padding", "6"), attr("border-radius", RadiusSmall),
		attr("transition", "bg 140ms ease"),
		event("onClick", clickSlot),
		dynAttr("bg", bgSlot), dynAttr("color", colorSlot),
		el("span"), attr("font-size", FontBody),
		gxscene.Op{Code: gxscene.opChildText, Arg: optionLabel(o)}, closeEl(),
		// 选中勾用预制矢量图标（check），替代 "✓" 字形。
		gxscene.Op{Code: gxscene.opComp, Arg: "SelectCheck", Slot: checkSlot},
		closeEl(),
	}
	disabled := o.Disabled
	return gxscene.render(gxscene.Template{Ops: ops, N: nSlots},
		func() any {
			return gxscene.Handler(func(ctx gxscene.EventContext) {
				if disabled {
					return
				}
				emitValue(onChange(), ctx, o.Value) // 回传选中值
				st.Close()                          // 选中后关闭浮层
			})
		},
		func() any {
		if selected() {
			return ThemeFill
		}
		return ThemePanel
		},
		func() any {
			if selected() {
				return ThemeAccent
			}
			return ThemeText
		},
		func() any {
			if selected() {
				return iconNode("check", 15, "primary")
			}
			return nil
		},
	)
}
