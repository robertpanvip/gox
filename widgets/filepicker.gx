package widgets

// FilePicker 是唯一无法用纯场景树表达的组件：打开文件对话框是 OS 原生能力。
// 因此它遵循与 Window 相同的两层模型——
//
//	契约层（此处，两端共用）：FileDialog 接口 + 注册表 + FilePicker 组件。
//	   组件只产出一个触发按钮，onClick 时调用注册的 FileDialog.OpenFile，
//	   把结果经 onPick 回传业务；不碰任何平台 API。
//
//	原生层（各后端/装配层各自实现）：实现 FileDialog 接口并注册。
//	   - Rust 桌面端：rfd / winit 原生对话框（见 backend/rust/go/filedialog.go）。
//	   - Skia / headless：无窗口环境安全降级（见 noopFileDialog）。
//
// 这样"结构"用 GX 验证、能力由原生各自实现，与 Window/Backend 的
// Contract + Adapter 模型完全一致，核心 widgets 包零平台依赖。
import (
	"sync"

	gxscene "github.com/robertpanvip/gox/runtime/scene"
)

// FileOptions 是文件对话框参数。
type FileOptions struct {
	Title       string   // 对话框标题
	Multiple    bool     // 是否多选
	Directory   bool     // 选择目录而非文件
	Filters     []string // 扩展名过滤，如 []string{".png", ".jpg"}
	DefaultPath string   // 初始目录
}

// FileDialog 是原生文件对话框能力契约。各后端/装配层实现它并注册。
// OpenFile 应在调用方 UI 线程上同步返回（原生对话框阻塞语义）。
type FileDialog interface {
	OpenFile(opts FileOptions) ([]string, error)
}

var (
	fileDialogMu sync.RWMutex
	fileDialog   FileDialog = noopFileDialog{}
)

// noopFileDialog 是安全降级：未注册任何实现时返回空选择，不 panic。
// headless / 测试 / 不支持对话框的后端走这里。
type noopFileDialog struct{}

func (noopFileDialog) OpenFile(FileOptions) ([]string, error) { return nil, nil }

// RegisterFileDialog 注册全局文件对话框实现。传 nil 复位为 noop。
func RegisterFileDialog(d FileDialog) {
	fileDialogMu.Lock()
	if d == nil {
		fileDialog = noopFileDialog{}
	} else {
		fileDialog = d
	}
	fileDialogMu.Unlock()
}

// OpenFile 调用当前注册的实现（供组件与业务直接使用）。
func OpenFile(opts FileOptions) ([]string, error) {
	fileDialogMu.RLock()
	d := fileDialog
	fileDialogMu.RUnlock()
	return d.OpenFile(opts)
}

// BindPick 把 func([]string) 包装成 FilePicker 的 onPick Handler。
// 选中路径从 ctx.Synthetic.Data["paths"] 取出（与 BindValue 同机制）。
func BindPick(fn func([]string)) gxscene.Handler {
	return gxscene.Handler(func(ctx gxscene.EventContext) {
		var paths []string
		if ctx.Synthetic != nil {
			if p, ok := ctx.Synthetic.Data["paths"].([]string); ok {
				paths = p
			}
		}
		fn(paths)
	})
}

// FilePicker 构造一个文件选择按钮。props:
//
//	label     string        按钮文字（默认 "选择文件"）
//	options   FileOptions   对话框参数（静态值或 func() FileOptions）
//	onPick    Handler       选中回传，用 BindPick 包装；Data["paths"]=路径列表
//	onCancel  Handler       取消回传（无选择时触发，可选）
//	width     string        按钮宽度
//	tone      强调色
//	disabled  bool          禁用
//
// 交互：点击 → 调 FileDialog.OpenFile → 有结果 emit paths 给 onPick，否则 onCancel。
// 组件本身无状态；对话框实现由装配层注册。
func FilePicker(props gxscene.Props) *gxscene.Instance {
	label := gxscene.get[string](props, "label")
	width := gxscene.get[string](props, "width")
	accent := toneColor(gxscene.get[string](props, "tone")())
	disabled := boolGet(props, "disabled", false)
	onPick := gxscene.get[gxscene.Handler](props, "onPick")
	onCancel := gxscene.get[gxscene.Handler](props, "onCancel")
	optsGet := fileOptionsGet(props)

	l := label()
	if l == "" {
		l = "选择文件"
	}

	const clickSlot = 0
	ops := []gxscene.Op{
		el("button"), attr("gx-role", "filepicker"),
		attr("variant", "secondary"), attr("bg", ThemePanel),
		attr("border", ThemeBorder), attr("border-width", HairlineWidth),
		attr("border-radius", RadiusControl), attr("padding", "10"),
		attr("color", accent),
	}
	if w := width(); w != "" {
		ops = append(ops, attr("width", w))
	}
	if disabled() {
		ops = append(ops, attr("opacity", "0.5"))
	}
	// disabled 在 handler 内即时读取（见下），无需动态属性插槽。
	ops = append(ops,
		gxscene.Op{Code: gxscene.opEvent, Key: "onClick", Slot: clickSlot},
		gxscene.Op{Code: gxscene.opChildText, Arg: l}, closeEl(),
	)

	return gxscene.render(gxscene.Template{Ops: ops, N: 1},
		func() any {
			return gxscene.Handler(func(ctx gxscene.EventContext) {
				if disabled() {
					return
				}
				paths, err := OpenFile(optsGet())
				if err != nil || len(paths) == 0 {
					if h := onCancel(); h != nil {
						h(ctx)
					}
					return
				}
				if h := onPick(); h != nil {
					h(withPaths(ctx, paths))
				}
			})
		},
	)
}

func withPaths(ctx gxscene.EventContext, paths []string) gxscene.EventContext {
	if ctx.Synthetic == nil {
		ctx.Synthetic = &gxscene.SyntheticEvent{Data: map[string]any{}}
	}
	if ctx.Synthetic.Data == nil {
		ctx.Synthetic.Data = map[string]any{}
	}
	ctx.Synthetic.Data["paths"] = paths
	return ctx
}

// fileOptionsGet 读取对话框参数，兼容静态值 / func() FileOptions / func() any。
func fileOptionsGet(props gxscene.Props) func() FileOptions {
	raw, ok := props["options"]
	if !ok {
		return func() FileOptions { return FileOptions{} }
	}
	return func() FileOptions {
		switch v := raw.(type) {
		case FileOptions:
			return v
		case func() FileOptions:
			return v()
		case func() any:
			if o, ok := v().(FileOptions); ok {
				return o
			}
		}
		return FileOptions{}
	}
}
